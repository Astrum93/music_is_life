rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    match /UserInfo/{document=**}{
      allow read, create, write: if request.auth != null
    }
    match /UserContents/{document=**} {
      allow read, create, write : if request.auth != null;
    }
     match /UserFriends/{document=**} {
      allow read, create, write : if request.auth != null;
    }
    match /UserChats/{document=**} {
      allow read, create, write : if request.auth != null;
    }
    match /message/{document=**} {
      allow read, create, write : if request.auth != null;
    }
  }
}